# =============================================================================
# llm-systems.toml — install template for the manager + alarm engine
# =============================================================================
#
#   • The installer copies this file to config/llm-systems.toml (mode 0600)
#     and fills in the host-specific values below.
#   • A key that is not in this file runs on its built-in default; see
#     llm-systems.toml.reference for every key.
#   • Agents do NOT read this file. They use their own agent_config.yaml.
#
# Anything marked ★ is a secret and MUST NOT be committed.
# =============================================================================


# ───────────────────────────── MANAGER ────────────────────────────────────
[manager]
host = "0.0.0.0"                                         # listen address
port = 5000                                              # listen port (HTTP)
tls_port = 5443                                          # set to 0 to disable HTTPS

tls_cert_file = ""
tls_key_file  = ""

alarm_engine_url = "http://localhost:8081"               # where the manager finds the alarm engine

[manager.telemetry]
install_report = true
crash_reports = true
heartbeat = false

[manager.agents]
enrollment_secret = ""                                   # new machines must send this to register; blank = any machine may register while enrollment is open

[manager.security]
admin_cidrs = ["127.0.0.1", "::1", "192.168.1.0/24", "192.168.2.0/24"]

[manager.auth]
username = "llmadmin"

# ★ Secret. scrypt hash "scrypt$<salt_b64>$<dk_b64>"; blank = first-run setup page.
password_hash = ""


# ───────────────────────────── ALARM ENGINE ───────────────────────────────
[alarm_engine]
host = "0.0.0.0"
port = 8081
manager_url = "http://localhost:5000"                    # back-channel to the manager
cors_origins = "http://localhost:5000,https://localhost:5443,http://localhost:8081,https://localhost:8081"

# ★ Secret. Bearer token for agent metric pushes; the installer generates one.
ingest_token = "REPLACE_ME"

# ★ Secret. Bearer token for the management routes; blank = they accept ingest_token.
management_token = ""

tls_enabled = true


# ───────────────────────────── INFLUXDB ───────────────────────────────────
[influxdb]
host = "localhost"
port = 8086
org  = "llm-systems-manager"
metrics_bucket        = "alarm_engine_metrics"           # raw points, short retention (e.g. 7d)
metrics_rollup_bucket = "alarm_engine_metrics_rollup"    # 1-min rollup, long retention (e.g. 90d)

[influxdb.tokens]
# ★ Secret. Per-bucket scoped tokens; rotate by editing here + restart.
metrics        = "REPLACE_ME"

metrics_rollup = "REPLACE_ME"

admin    = ""


# ───────────────────────────── NOTIFICATIONS ──────────────────────────────
[notifications.smtp]
# ★ Secret. App-specific password for iCloud/Gmail/etc.
server   = "smtp.mail.example.com"
port     = 587
user     = "you@example.com"
password = "app-specific-password-here"

[notifications.twilio]
# ★ Secret (when used). Leave blank to disable SMS.
account_sid  = ""
auth_token   = ""
from_number  = ""

[notifications.discord]
# ★ Secret (when used). Leave blank to disable Discord.
webhook_url = ""


# ───────────────────────────── PATHS ──────────────────────────────────────
[paths]
log_dir         = "/var/log/llm-systems-manager"         # manager + alarm engine log files


# ───────────────────────────── LOGGING ────────────────────────────────────
[logging]
level   = "INFO"                                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
